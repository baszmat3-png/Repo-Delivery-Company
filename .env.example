# للتشغيل المحلي أو على Render (على Render تُضبط من لوحة Environment)
PORT=3000
DATABASE_URL=            # PostgreSQL. اتركه فارغاً محلياً لاستخدام SQLite
JWT_SECRET=غيّر-هذا-لنص-عشوائي-طويل
ADMIN_PHONE=07700000000
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية
SEED_DEMO=0              # 1 لتحميل بيانات تجريبية

# --- إشعارات الهاتف (اختياري) ---
# مفاتيح Web Push تُولَّد تلقائياً وتُحفظ في قاعدة البيانات، لا تحتاج ضبطاً.
VAPID_SUBJECT=mailto:you@example.com
# لتطبيق أندرويد (Firebase Cloud Messaging): الصق ملف حساب الخدمة JSON (أو base64 له)
FIREBASE_SERVICE_ACCOUNT=
